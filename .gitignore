# ---- Python 缓存与构建产物 ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 虚拟环境（本地 119MB，绝不入库）----
.venv/
venv/
env/

# ---- 本地配置与密钥 ----
# 真实密钥一律走环境变量；只保留样例文件供他人照抄。
.env
.env.*
!.env.example
*.pem
*.key

# ---- 运行时数据 ----
# SQLite 会在首次启动时由 seed 自动重建（见 src/infra/core/settings.py），
# 因此库文件属于运行产物而不是源码；-shm/-wal 是 WAL 模式的临时文件。
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite3
*.log

# ---- 编辑器 / 工具目录 ----
.trae/
.vscode/
.idea/
