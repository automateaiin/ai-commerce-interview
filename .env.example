# 项目一：出海电商 AI Infra 与 MCP 服务集群
# 复制为 .env 后按需修改。真实密钥只放这里，绝不进 YAML、不进仓库。

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# ---- 模型接入（provider_mode: mock | openai_compat | auto）----
PROVIDER_MODE=mock
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=

# ---- 存储 ----
# 本地默认 SQLite；生产切 PostgreSQL：postgresql+asyncpg://user:pass@host:5432/infra
DATABASE_URL=sqlite+aiosqlite:///./data/infra.db
# 未配置 REDIS_URL 时配额自动降级为进程内原子实现（仅单实例有效）
# REDIS_URL=redis://localhost:6379/0

# ---- 超时与重试 ----
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
TOOL_TIMEOUT_S=8

# ---- 配额（预留-实扣）----
QUOTA_ENABLED=true
QUOTA_REQUESTS_PER_WINDOW=600
QUOTA_TOKENS_PER_WINDOW=200000

# ---- 限流（滑动窗口，与「配额」是两条不同的轴）----
# 配额管「窗口内总量与计费」（超限要能对账），限流管「瞬时流量整形」（超限快速拒绝即可）。
# IP 维度在鉴权前执行（401 狂刷也要拦），Service 维度在鉴权后执行（那时才知道是谁）。
RATELIMIT_ENABLED=true
RATELIMIT_IP_LIMIT=600
RATELIMIT_IP_WINDOW_S=60
RATELIMIT_SERVICE_LIMIT=600
RATELIMIT_SERVICE_WINDOW_S=60

# ---- 可观测（TelemetryPort）----
# console（默认，零依赖）| otel（需装 opentelemetry；依赖缺失时自动降级并记日志）
TELEMETRY_BACKEND=console

# ---- 成本预算（按 Service/Agent 聚合，日预算 + 超阈值降级）----
BUDGET_ENABLED=true
# 单个 Agent 的日 Token 硬上限（UTC 自然日切分）；超过直接 429
BUDGET_DAILY_TOKENS_PER_AGENT=2000000
# 软阈值：用掉日预算此比例后自动降级到 Lite 模型（不中断业务）
BUDGET_DOWNGRADE_RATIO=0.8
# 降级目标逻辑模型；留空则用 routing.default
BUDGET_LITE_MODEL=
# 降级后单请求输出上限（降级只换模型不控长度，成本一样会涨）
BUDGET_LITE_MAX_OUTPUT_TOKENS=512

# ---- 评测（六维：准确性 / Grounding / Tool Selection / Safety / 成本 / 延迟）----
EVAL_ACCURACY_THRESHOLD=0.7
EVAL_MAX_COST_USD=0.05
EVAL_MAX_LATENCY_MS=5000

# ---- Prompt 模板中心 ----
# 模板与 Agent Role 的单一事实来源；文件缺失/不可解析时显式降级到内置模板并记日志
# PROMPTS_CONFIG_PATH=./config/prompts.yaml

# ---- 子 Agent 护栏 ----
AGENT_MAX_STEPS=6
AGENT_TOTAL_TIMEOUT_S=60
AGENT_TOKEN_BUDGET=20000

# ---- Harness 执行层护栏（项目二） ----
# 成本上限（美元）；0 表示不单独设，只按 token 熔断
HARNESS_COST_BUDGET_USD=0
# 连续失败熔断阈值（整轮工具全失败累计到此值即终止并交接）
HARNESS_MAX_CONSECUTIVE_ERRORS=3
# 打转检测时间窗（轮）：窗口内出现同参数调用即判定为原地打转
HARNESS_REPEAT_WINDOW_STEPS=3
# 合法轮询豁免工具名（逗号分隔），如 get_order_status
HARNESS_REPEAT_EXEMPT_TOOLS=
# 单轮工具调用数量上限
HARNESS_MAX_CALLS_PER_TURN=4
# 回填给模型的单条 observation 字符上限
HARNESS_MAX_OBSERVATION_CHARS=1500

# ---- 数据平台（项目三） ----
# 切片：token 上限 + overlap；时间窗只做「拿不到语义边界时」的初筛兜底
DATA_CHUNK_MAX_TOKENS=220
DATA_CHUNK_OVERLAP_TOKENS=40
DATA_CHUNK_TIME_WINDOW_S=300
# 离线哈希向量维度（生产为真实 embedding 维度）
DATA_EMBED_DIM=256
# 混合检索：进入重排的候选池大小 / 最终返回条数
DATA_RERANK_CANDIDATES=20
DATA_RECALL_TOP_K=3
# 拼进 Prompt 的证据总字符预算
DATA_CONTEXT_CHAR_BUDGET=1200
# 训练集导出批次版本号
DATA_EXPORT_VERSION=v1

# ---- 数据平台（项目四补齐：三级切片 / 重排端口 / 训练产物）----
# 切片模式：semantic（语义边界，默认）| hierarchical（L1 滑动窗口 / L2 段落 / L3 章节 + Auto-merging）
# hierarchical 下只有 L1 参与召回，L2/L3 仅用于命中后向上合并回完整上下文
DATA_CHUNK_MODE=semantic
# L1 = 句子滑动窗口长度（句）；L2/L3 = 聚合多少个 L1
DATA_CHUNK_L1_WINDOW=2
DATA_CHUNK_L2_GROUP=3
DATA_CHUNK_L3_GROUP=9
# Auto-merging 阈值：同一父块下命中的子块占比达到该值才合并回父块（越高越保守）
DATA_MERGE_RATIO=0.5
# 重排后端：lexical（本地词典，离线可跑）| jina（远端，需 key；缺 key 时显式降级为 lexical）
DATA_RERANK_BACKEND=lexical
DATA_JINA_API_KEY=
DATA_JINA_RERANK_URL=https://api.jina.ai/v1/rerank
DATA_JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# 训练产物里写的基础模型名 —— 只是配置产物，训练在外部环境执行（本仓库不装 LLaMA-Factory、不跑 GPU）
DATA_TRAINING_BASE_MODEL=Qwen2.5-7B-Instruct

# ---- 宿主业务库 commerce（项目一白名单 Tool 的真实数据源）----
# 业务库与基础设施库分开：infra 库存 trace/记忆/审计，业务库存商品/订单/会员/优惠券
COMMERCE_DATABASE_URL=sqlite+aiosqlite:///./data/commerce.db
# 启动时灌演示数据（库非空则跳过，幂等）；COMMERCE_SEED_FORCE 仅测试用，会重置演示数据
COMMERCE_SEED_ENABLED=true
COMMERCE_SEED_FORCE=false
# 会员 token 签名密钥。**必须配置**；未配置时降级为进程内随机密钥（重启即失效）并打告警日志
COMMERCE_MEMBER_TOKEN_SECRET=
COMMERCE_MEMBER_TOKEN_TTL_S=86400
# 未付款订单存活时长（分钟），超时由 sweeper 取消并回滚库存
COMMERCE_ORDER_TTL_MINUTES=30
# sweeper 周期（秒）；<=0 表示显式禁用后台清理
COMMERCE_SWEEPER_INTERVAL_S=60
# 单会员每小时下单上限（业务限流，防单账号刷单；与网关限流是两条轴）
COMMERCE_ORDER_RATE_PER_HOUR=20

# ---- 应用层（项目一 agents：编排 / 双端 Agent / HITL / 实时语音）----
# 单次 Agent 运行的步数上限（角色 Agent 的默认值；请求级可收紧）
AGENTS_MAX_STEPS=6
# Handoff 转派次数上限（没有上限的转派链 = 无界模型调用）
AGENTS_MAX_HANDOFFS=2
# 规划器给出的子任务数上限
AGENTS_MAX_TASKS=4
# 规划器使用的逻辑模型；留空走网关默认路由
AGENTS_PLANNER_MODEL=
# 交易类回答的事实绑定闸门（关闭仅用于对照实验）
AGENTS_GROUNDING_ENABLED=true
# 反馈收集器容量（跨请求存活但有界）
AGENTS_FEEDBACK_LIMIT=200
# 待确认检查点容量上限
AGENTS_HITL_MAX_PENDING=200
# HITL Resume Token 签名密钥；留空回退 INTERNAL_SERVICE_TOKEN，再回退进程内随机值并告警
AGENTS_HITL_SECRET=

# ---- 应用层（项目二 ops：内容工作流 / 流式 / 并行 / 多模态 / 直播 / 分析 / 自进化）----
# 单节点失败重试次数（节点级，重试仍失败则中断后续层）
OPS_MAX_ATTEMPTS=2
# 结构化输出不合法时的重试次数；耗尽后用确定性兜底并记录降级原因
OPS_STRUCTURED_RETRIES=1
# 并行单元的最大并发（线程池 + 信号量）
OPS_PARALLEL_MAX_CONCURRENCY=4
# 直播分段转录的窗口长度（秒）
OPS_LIVE_WINDOW_S=90
# 相邻窗口的重叠长度（秒）：用于修切点断句，代价是重复文本需要去重
OPS_LIVE_OVERLAP_S=15
# 每批分析的段数（分批是长直播成本可控的关键）
OPS_LIVE_BATCH_SIZE=3
# 素材资产库容量上界（跨请求存活但必须有界）
OPS_ASSET_MAX_ASSETS=500
# 自进化回流池容量上界
OPS_SELFEVOLVE_MAX_EVENTS=500
# 复杂分析（成分卖点/直播批分析）使用的逻辑模型
OPS_ANALYSIS_MODEL=chat-pro
# 短文案生成使用的轻量模型（模型分工降本）
OPS_COPY_MODEL=chat-lite
# 素材向量版本号（写入资产，便于未来重建索引时对账）
OPS_ASSET_EMBED_VERSION=hash-256-v1

# ---- 内部服务与 MCP 传输 ----
# MCP 端点只接受内部调用：凭证不配置则端点拒绝所有请求（不做「本地就放行」的例外）
INTERNAL_SERVICE_TOKEN=change-me-internal
# MCP 的 Host 白名单（DNS rebinding 防护，只做加法不做关闭）；回环地址已默认允许
MCP_ALLOWED_HOSTS=

# ---- 管理端点 ----
# 未配置 ADMIN_TOKEN 时 /admin/config/reload 直接 403 关闭
ADMIN_TOKEN=

# ---- 桥接层演示用 API Key（project:key:scopes 见 config/models.yaml 同目录的桥接配置）----
BRIDGE_BOOTSTRAP_KEYS=true
